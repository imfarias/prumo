<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; script-src 'self'">
<meta name="generator" content="Prumo">
<meta name="prumo-tela" content="{{ tela.id }}">
<meta name="prumo-estado" content="{{ estado.id }}">
<title>{{ tela.titulo }} · {{ projeto.nome }}</title>
<link rel="stylesheet" href="{{ recursos }}/prumo.css">
{% if cssAdicional %}<link rel="stylesheet" href="{{ recursos }}/{{ cssAdicional }}">{% endif %}
</head>
<body data-testid="{{ tela.testid }}-pagina" data-layout="{{ layout }}">
{% block corpo %}{% endblock %}
</body>
</html>
