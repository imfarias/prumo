{
  "name": "prumo-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/cli"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run build && vitest run",
    "cobertura": "npm run build && vitest run --coverage",
    "tipos": "tsc -b && tsc -p packages/motor/web",
    "prumo": "tsx apps/cli/src/main.ts"
  },
  "devDependencies": {
    "@types/markdown-it": "14.2.0",
    "@types/node": "22.20.5",
    "@types/nunjucks": "3.2.6",
    "@types/pngjs": "6.0.5",
    "@vitest/coverage-v8": "5.1.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
